# ── DocDrift engine ──────────────────────────────────────────────────────────
# Port the engine listens on (Docker image uses PORT=3000 internally).
PORT=3000

# ── AI provider chain (all optional, resolved in order) ─────────────────────
# 1 · Ollama — open-weight Gemma on your machine (https://ollama.com)
#     docker compose --profile local-ai up   or   ollama serve
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# 2 · Gemini API — hosted open-weight Gemma on the FREE tier.
#     Key from https://aistudio.google.com — no credit card required.
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-31b-it

# 3 · Deterministic engine — always available, zero network. Nothing to set.

# ── Sentry error tracking (free tier) ──────────────────────────────────────
# DSN from https://sentry.io — leave empty to disable (in-memory ledger only).
SENTRY_DSN=

# ── misc ─────────────────────────────────────────────────────────────────────
# Restrict CORS in production (default: same-origin friendly).
CORS_ORIGIN=
# Set to 0 to silence parser-failure warnings in logs.
LOG_PARSE_FAILURES=1

# ── GitHub login (Studio) ────────────────────────────────────────────────────
# Create a free OAuth App: GitHub → Settings → Developer settings → OAuth Apps
# Authorization callback URL: <public origin>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated OAuth scopes (repo covers private repos).
GITHUB_OAUTH_SCOPE=repo read:user

# ── GitHub webhook (push → draft docs PR) ────────────────────────────────────
# Shared secret used to verify GitHub push webhook signatures (HMAC-SHA256).
# Set this to a random string and enter the SAME value in your GitHub repo
# webhook settings → "Secret". Generate one with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# Optional: directory for the JSON session/webhook store (default: ./data).
# Never commit this directory — it holds user OAuth tokens.
DOC_DRIFT_DATA_DIR=


# ── deployment / keep-warm ───────────────────────────────────────────────────
# Public origin of the deployment. Used for the OAuth redirect/callback and the
# keep-warm self-ping. On Render, RENDER_EXTERNAL_URL is picked up
# automatically — only set APP_BASE_URL if you serve DocDrift on your own domain.
APP_BASE_URL=
# Keep-warm: pings <origin>/api/health every 13.5 min in production so free
# tiers (Render et al.) never hit the ~15 min idle sleep. Set to "off" to disable.
KEEP_WARM=on
# Force Secure cookies ("force"), or leave "auto" to infer from the request.
COOKIE_SECURE=auto
